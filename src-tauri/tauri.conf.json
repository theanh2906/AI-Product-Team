{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ProductCrew",
  "version": "0.1.145",
  "identifier": "com.productcrew.desktop",
  "build": {
    "beforeDevCommand": {
      "cwd": "../frontend",
      "script": "npm run tauri:prepare && npm run dev",
      "wait": false
    },
    "beforeBuildCommand": {
      "cwd": "../frontend",
      "script": "npm run build:go && npm run tauri:prepare",
      "wait": true
    },
    "devUrl": "http://localhost:8000",
    "frontendDist": "../frontend/dist/frontend/browser"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ProductCrew",
        "width": 1440,
        "height": 900,
        "minWidth": 1180,
        "minHeight": 720,
        "center": true,
        "resizable": true,
        "maximizable": true,
        "decorations": true,
        "fullscreen": false,
        "maximized": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:8081; img-src 'self' asset: http://asset.localhost http://127.0.0.1:8081 data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
